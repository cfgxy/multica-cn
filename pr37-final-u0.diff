+func TestLoadV5RetainsPreMigrationBackupForRollback(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "state.json")
+	v5 := []byte(`{"version":5,"templates":[{"id":"qa","scope_profile_id":"multica-qa"}],"instances":[],"leases":[{"id":"ls-000001","template_id":"qa","provider_kind":"docker","state":"released"}],"executions":[],"artifacts":[],"staged_artifacts":[],"managed_applications":[],"sequences":{}}`)
+	staleGenericBackup := []byte(`{"version":5,"templates":[],"instances":[],"leases":[],"executions":[],"artifacts":[],"staged_artifacts":[],"managed_applications":[],"sequences":{}}`)
+	if err := os.WriteFile(path, v5, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path+".bak", staleGenericBackup, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	s, err := Load(path)
+	if err != nil {
+		t.Fatalf("v5 状态文件应可迁移加载: %v", err)
+	}
+	if err := s.Mutate(func(*State) {}); err != nil {
+		t.Fatalf("迁移后的状态应可写入: %v", err)
+	}
+	persisted, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !containsVersion(persisted, `"version": `+strconv.Itoa(StateVersion)) {
+		t.Fatalf("迁移后应写入当前版本: %s", persisted)
+	}
+	backup, err := os.ReadFile(path + ".v5.bak")
+	if err != nil {
+		t.Fatalf("v5 回退备份必须保留: %v", err)
+	}
+	if string(backup) != string(v5) {
+		t.Fatalf("回退备份必须保留升级前 v5 状态: %s", backup)
+	}
+	if _, err := Load(path); err != nil {
+		t.Fatalf("v6 持久化后的重启应成功: %v", err)
+	}
+	backup, err = os.ReadFile(path + ".v5.bak")
+	if err != nil {
+		t.Fatalf("重启后读取 v5 回退备份: %v", err)
+	}
+	if string(backup) != string(v5) {
+		t.Fatalf("v6 重启不得覆盖 v5 回退备份: %s", backup)
+	}
+	v5AfterRollback := []byte(`{"version":5,"templates":[{"id":"qa","scope_profile_id":"multica-qa"}],"instances":[],"leases":[{"id":"ls-000001","template_id":"qa","provider_kind":"docker","state":"released"}],"executions":[],"artifacts":[],"staged_artifacts":[],"managed_applications":[],"sequences":{}}`)
+	if err := os.WriteFile(path, v5AfterRollback, 0o600); err != nil {
+		t.Fatalf("模拟回退后的 v5 状态写入: %v", err)
+	}
+	s, err = Load(path)
+	if err != nil {
+		t.Fatalf("再次从 v5 升级应成功: %v", err)
+	}
+	if err := s.Mutate(func(*State) {}); err != nil {
+		t.Fatalf("再次升级后的状态应可写入: %v", err)
+	}
+	backup, err = os.ReadFile(path + ".v5.bak")
+	if err != nil {
+		t.Fatalf("读取第二次升级回退备份: %v", err)
+	}
+	if string(backup) != string(v5AfterRollback) {
+		t.Fatalf("再次升级必须替换为当前 v5 回退输入: %s", backup)
+	}
+}
