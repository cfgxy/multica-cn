+			lease := e.awaitLease(t, result.LeaseID, store.LeaseActive)
+			instRef := provider.ProviderRef(e.leaseInstanceRef(t, result.LeaseID))
+			if len(lease.PublishedPorts) == 0 || len(e.stub.PublishedPortsFor(instRef)) == 0 {
