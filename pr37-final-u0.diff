diff --git a/cmd/resource-pool-mcp/main_test.go b/cmd/resource-pool-mcp/main_test.go
index 95db79d..b26ce3a 100644
--- a/cmd/resource-pool-mcp/main_test.go
+++ b/cmd/resource-pool-mcp/main_test.go
@@ -284,0 +285,68 @@ var errSentinel = errors.New("http 故障哨兵")
+func TestValidateRetainedDockerScopesRejectsProviderRemoval(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		state   store.State
+		wantErr bool
+	}{
+		{
+			name: "active frozen profile",
+			state: store.State{Leases: []store.Lease{{
+				ID: "ls-active", ProviderKind: "docker", State: store.LeaseActive,
+				ScopeProfileID: "multica-qa", ScopeProfileKnown: true,
+			}}},
+			wantErr: true,
+		},
+		{
+			name: "expired unknown profile",
+			state: store.State{Leases: []store.Lease{{
+				ID: "ls-expired", ProviderKind: "docker", State: store.LeaseExpired,
+			}}},
+			wantErr: true,
+		},
+		{
+			name: "active known unscoped lease",
+			state: store.State{Leases: []store.Lease{{
+				ID: "ls-unscoped", ProviderKind: "docker", State: store.LeaseActive,
+				ScopeProfileKnown: true,
+			}}},
+			wantErr: true,
+		},
+		{
+			name: "pending lease",
+			state: store.State{Leases: []store.Lease{{
+				ID: "ls-pending", ProviderKind: "docker", State: store.LeasePending,
+			}}},
+			wantErr: true,
+		},
+		{
+			name: "idle instance",
+			state: store.State{Instances: []store.ResourceInstance{{
+				ID: "ri-idle", ProviderKind: "docker", State: store.InstanceIdle,
+			}}},
+			wantErr: true,
+		},
+		{
+			name: "terminal scoped lease",
+			state: store.State{Leases: []store.Lease{{
+				ID: "ls-reclaimed", ProviderKind: "docker", State: store.LeaseReclaimed,
+				ScopeProfileID: "multica-qa", ScopeProfileKnown: true,
+			}}},
+		},
+		{
+			name: "terminal lease with published port",
+			state: store.State{Leases: []store.Lease{{
+				ID: "ls-port-debt", ProviderKind: "docker", State: store.LeaseReleased,
+				PublishedPorts: []store.PublishedPort{{GuestPort: 5432, HostPort: 15432, Protocol: "tcp"}},
+			}}},
+			wantErr: true,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			err := validateRetainedDockerScopes(tc.state, nil)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("validateRetainedDockerScopes() error = %v, wantErr %t", err, tc.wantErr)
+			}
+		})
+	}
+}
+
