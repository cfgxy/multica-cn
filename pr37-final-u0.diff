@@ -207,0 +211,26 @@ func awaitShutdown(ctx context.Context, stop context.CancelFunc, errCh <-chan er
+// validateRetainedDockerScopes prevents provider removal from orphaning any
+// Docker instance or lease that still needs lifecycle ownership.
+func validateRetainedDockerScopes(state store.State, dockerProvider *docker.Provider) error {
+	if dockerProvider != nil {
+		return dockerProvider.ValidateRetainedScopeProfiles(state)
+	}
+	for _, lease := range state.Leases {
+		if lease.ProviderKind != docker.Kind {
+			continue
+		}
+		if len(lease.PublishedPorts) > 0 {
+			return fmt.Errorf("存量 Docker 租约 %s（%s）仍有端口映射待回收，拒绝移除 Docker provider 后启动", lease.ID, lease.State)
+		}
+		if lease.State != store.LeasePending && lease.State != store.LeaseActive && lease.State != store.LeaseExpired {
+			continue
+		}
+		return fmt.Errorf("存量 Docker 租约 %s（%s）仍需实例或 scope 回收，拒绝移除 Docker provider 后启动", lease.ID, lease.State)
+	}
+	for _, inst := range state.Instances {
+		if inst.ProviderKind == docker.Kind && inst.State != store.InstanceDestroyed {
+			return fmt.Errorf("存量 Docker 实例 %s（%s）仍需生命周期处置，拒绝移除 Docker provider 后启动", inst.ID, inst.State)
+		}
+	}
+	return nil
+}
