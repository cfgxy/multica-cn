+
+func validateMulticaQARuntimeHealth(running string, postgresJSON []byte) error {
+	services := strings.Fields(running)
+	if !containsService(services, "postgres") || !containsService(services, "runner") {
+		return errors.New("Multica QA PostgreSQL 或 runner 未运行")
+	}
+	return validateMulticaQAPostgresHealth(postgresJSON)
+}
+
+func validateMulticaQAPostgresHealth(postgresJSON []byte) error {
+	type composeServiceStatus struct {
+		State  string `json:"State"`
+		Health string `json:"Health"`
+	}
+	var statuses []composeServiceStatus
+	trimmed := bytes.TrimSpace(postgresJSON)
+	if len(trimmed) > 0 && trimmed[0] == '[' {
+		if err := json.Unmarshal(trimmed, &statuses); err != nil {
+			return errors.New("Multica QA PostgreSQL 状态格式无效")
+		}
+	} else {
+		decoder := json.NewDecoder(bytes.NewReader(trimmed))
+		for {
+			var status composeServiceStatus
+			err := decoder.Decode(&status)
+			if err == io.EOF {
+				break
+			}
+			if err != nil {
+				return errors.New("Multica QA PostgreSQL 状态格式无效")
+			}
+			statuses = append(statuses, status)
+		}
+	}
+	if len(statuses) != 1 {
+		return errors.New("Multica QA PostgreSQL 状态数量异常")
+	}
+	status := statuses[0]
+	if !strings.EqualFold(status.State, "running") || !strings.EqualFold(status.Health, "healthy") {
+		return errors.New("Multica QA PostgreSQL 未处于 healthy 状态")
+	}
+	return nil
+}
