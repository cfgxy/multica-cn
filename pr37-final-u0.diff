+func validateMulticaQAResolved(resolved resolvedCompose, object ScopeObject, credential *ScopedCredential) error {
+	if len(resolved.Services) != 2 {
+		return errors.New("Multica QA resolved profile 必须且只能包含 postgres 与 runner 服务")
+	}
+	postgres, hasPostgres := resolved.Services["postgres"]
+	runner, hasRunner := resolved.Services["runner"]
+	if !hasPostgres || !hasRunner {
+		return errors.New("Multica QA resolved profile 缺少 postgres 或 runner 服务")
+	}
+	var healthcheck struct {
+		Disable bool     `json:"disable"`
+		Test    []string `json:"test"`
+	}
+	if len(postgres.Healthcheck) == 0 || json.Unmarshal(postgres.Healthcheck, &healthcheck) != nil || healthcheck.Disable || len(healthcheck.Test) == 0 ||
+		strings.EqualFold(healthcheck.Test[0], "NONE") || runner.DependsOn["postgres"].Condition != "service_healthy" {
+		return errors.New("Multica QA runner 未等待 PostgreSQL healthcheck")
+	}
+	password := postgres.Environment["POSTGRES_PASSWORD"]
+	if password == "" || postgres.Environment["POSTGRES_DB"] != object.DataNamespaces.Database ||
+		postgres.Environment["POSTGRES_USER"] != object.DataNamespaces.DBRole {
+		return errors.New("Multica QA PostgreSQL 未绑定当前 scope 的数据库、角色或凭据")
+	}
+	urlPrefix := "postgres://" + object.DataNamespaces.DBRole + ":"
+	urlSuffix := "@postgres:5432/" + object.DataNamespaces.Database + "?sslmode=disable"
+	databaseURL := runner.Environment["DATABASE_URL"]
+	if !strings.HasPrefix(databaseURL, urlPrefix) || !strings.HasSuffix(databaseURL, urlSuffix) ||
+		strings.TrimSuffix(strings.TrimPrefix(databaseURL, urlPrefix), urlSuffix) != password {
+		return errors.New("Multica QA runner 未绑定当前 scope 的 PostgreSQL URL")
+	}
+	if credential != nil && credential.Values["DB_PASSWORD"] != password {
+		return errors.New("Multica QA PostgreSQL 未使用本次签发的 scope 凭据")
+	}
