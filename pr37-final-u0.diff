+
+func assertDockerHandoffScopesRevoked(t *testing.T, adapter *phaseTestProvider, targetGeneration uint64) {
+	t.Helper()
+	if len(adapter.revocations) != 2 {
+		t.Fatalf("Docker handoff 应清理 source 与 target scope，得到 %d 次：%+v", len(adapter.revocations), adapter.revocations)
+	}
+	want := []provider.ExecutionScope{
+		{ProfileID: "sub2api", Phase: store.LeasePhaseDEV, Generation: 1},
+		{ProfileID: "sub2api", Phase: store.LeasePhaseQA, Generation: targetGeneration},
+	}
+	for i, scope := range want {
+		got := adapter.revocations[i][0]
+		if got.ProfileID != scope.ProfileID || got.Phase != scope.Phase || got.Generation != scope.Generation {
+			t.Fatalf("第 %d 个 scope 清理不正确：得到 %+v，期望 %+v", i, got, scope)
+		}
+	}
+}
