diff --git a/internal/exec/managed_app_test.go b/internal/exec/managed_app_test.go
new file mode 100644
index 0000000..bfb2fbf
--- /dev/null
+++ b/internal/exec/managed_app_test.go
@@ -0,0 +1,72 @@
+package exec
+
+import (
+	"context"
+	"testing"
+
+	"github.com/cfgxy/guxy-resource-pool-mcp/internal/config"
+	"github.com/cfgxy/guxy-resource-pool-mcp/internal/provider"
+	"github.com/cfgxy/guxy-resource-pool-mcp/internal/provider/faultinject"
+	"github.com/cfgxy/guxy-resource-pool-mcp/internal/store"
+)
+
+type managedWebTestProvider struct {
+	*fakeProvider
+	called bool
+}
+
+func (p *managedWebTestProvider) ManagedWebGet(_ context.Context, _ provider.ProviderRef, scope provider.ExecutionScope, service string, port int, requestPath string) ([]byte, error) {
+	p.called = true
+	if scope.ProfileID != "qa-profile" || service != "app" || port != 8080 || requestPath != "/" {
+		return nil, &managedWebTestError{}
+	}
+	return []byte("ok"), nil
+}
+
+type managedWebTestError struct{}
+
+func (*managedWebTestError) Error() string { return "managed web bridge 参数不符" }
+
+func TestManagedAppWebContentThroughListFailure(t *testing.T) {
+	e := newEnv(t)
+	e.cfg.ManagedApps = []config.ManagedAppConfig{{
+		ID:             managedAppID,
+		TemplateID:     "tpl-small",
+		ScopeProfileID: "qa-profile",
+		ServiceName:    "app",
+		ServicePort:    8080,
+		WebPath:        "/",
+	}}
+	lease, err := e.pl.GetLease(e.leaseID)
+	if err != nil {
+		t.Fatalf("读取租约: %v", err)
+	}
+	if err := e.pl.MutateState(func(st *store.State) {
+		for i := range st.Instances {
+			if st.Instances[i].ID == lease.InstanceID {
+				st.Instances[i].ProviderKind = "docker"
+			}
+		}
+		for i := range st.Leases {
+			if st.Leases[i].ID == lease.ID {
+				st.Leases[i].ScopeProfileID = "qa-profile"
+				st.Leases[i].ScopeProfileKnown = true
+			}
+		}
+		st.ManagedApplications = append(st.ManagedApplications, store.ManagedApplication{
+			ID: managedAppID, LeaseID: lease.ID, Phase: lease.Phase, Generation: lease.Generation, State: "started",
+		})
+	}); err != nil {
+		t.Fatalf("准备 Docker managed-app 状态: %v", err)
+	}
+	bridge := &managedWebTestProvider{fakeProvider: e.prov}
+	e.pl.SetProviderForTest("docker", faultinject.NewListFailure(bridge))
+
+	body, err := e.m.ManagedAppWebContent(context.Background(), lease.ID, lease.Generation, "/")
+	if err != nil {
+		t.Fatalf("ListFailure 包装后 managed web 应抵达底层 bridge: %v", err)
+	}
+	if string(body) != "ok" || !bridge.called {
+		t.Fatalf("底层 ManagedWebBridge 未被调用: body=%q called=%t", body, bridge.called)
+	}
+}
