+				return p.AdminDestroyInstance(ctx, instID)
+			},
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			e := newEnv(t)
+			adapter, leaseID, instID := setupExpiredDockerHandoff(t, e)
+			adapter.revokeErrs = 1
+
+			if err := tc.run(context.Background(), e.pool, leaseID, instID); err == nil {
