# versions.env — pinned inputs for the multica-slot-base bake pipeline
# (RUYI-676 P1). Sourced by build-seed.sh; the ISO pin mirrors the validated
# RUYI-454/RUYI-679 preparation (releases.ubuntu.com + SHA256SUMS, asset kept
# at I:\resource-pool\iso\ on guxy-desk). Bump = new image version, never an
# in-place mutation of an existing read-only base.

UBUNTU_VERSION=24.04.5
UBUNTU_ISO_NAME=ubuntu-24.04.5-live-server-amd64.iso
UBUNTU_ISO_URL="https://releases.ubuntu.com/24.04.5/ubuntu-24.04.5-live-server-amd64.iso"
UBUNTU_ISO_SHA256=97f3d7ffb032c3eb3b23d2c8be9cc76e60c2c1f2c0146ba5ba9fe01cafae0fd8

# Runtimes (方案 §4.1: PostgreSQL + 运行时依赖; NO build toolchain)
NODE_MAJOR=22
POSTGRES_MAJOR=16

# Guest identity facts
# SLOT_IMAGE_USER is the pool-facing SSH identity: hyperv.guest_user defaults
# to "rpmadmin" (pool config, docs/06 §8.3 制备口径) and has no per-template
# override, so the seed identity user MUST be rpmadmin. RUYI-727: a slotadmin
# rename here baked images no pool credential could reach (new-create
# publickey denial 2/2, multica-slot-base@2026.10.12).
SLOT_IMAGE_USER=rpmadmin
SLOT_IMAGE_HOSTNAME=multica-slot-base

# Base disk logical capacity: must cover the largest template disk_gb.
# Differencing lease disks inherit this maximum (New-VHD -Differencing takes
# no -SizeBytes — RUYI-679 实测语义).
IMAGE_LOGICAL_GB=80
