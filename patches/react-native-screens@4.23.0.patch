@@ -0,0 +1,101 @@
+package com.swmansion.rnscreens.bottomsheet
+
+import android.view.MotionEvent
+import android.view.View
+import androidx.coordinatorlayout.widget.CoordinatorLayout
+import com.google.android.material.bottomsheet.BottomSheetBehavior
+import com.swmansion.rnscreens.Screen
+
+/**
+ * BottomSheetBehavior for the in-stack formSheet with two RUYI-637 gesture
+ * corrections on top of Material 1.13.
+ */
+class SheetGestureBehavior : BottomSheetBehavior<Screen>() {
+    // RUYI-637: RN's ScrollView claims touches inside the scrolling content even
+    // when it cannot scroll any further in the gesture direction (and on some
+    // versions does not dispatch nested scroll events at all), so Material never
+    // gets the chance to drag the sheet from the content area. Reproduce the
+    // nested-scroll hand-off manually: intercept the stream only when the
+    // scrolling child is exhausted toward the drag direction, letting the
+    // content scroll first.
+    private var gestureStartY = 0f
+    private var gestureScrollChild: View? = null
+    private var touchSlop = -1
+
+    private fun readScrollingChild(): View? {
+        var c: Class<*> = BottomSheetBehavior::class.java
+        while (c != Any::class.java) {
+            try {
+                val f = c.getDeclaredField("nestedScrollingChildRef")
+                f.isAccessible = true
+                return (f.get(this) as? java.lang.ref.WeakReference<*>)?.get() as? View
+            } catch (e: NoSuchFieldException) {
+                c = c.superclass ?: break
+            }
+        }
+        return null
+    }
+
+    override fun onInterceptTouchEvent(
+        parent: CoordinatorLayout,
+        child: Screen,
+        event: MotionEvent,
+    ): Boolean {
+        val superResult = super.onInterceptTouchEvent(parent, child, event)
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                gestureStartY = event.y
+                gestureScrollChild = readScrollingChild()
+                if (touchSlop < 0) {
+                    touchSlop = android.view.ViewConfiguration.get(parent.context).scaledTouchSlop
+                }
+            }
+
+            MotionEvent.ACTION_MOVE -> {
+                val scroll = gestureScrollChild
+                val dy = event.y - gestureStartY
+                if (!superResult &&
+                    scroll != null &&
+                    touchSlop > 0 &&
+                    kotlin.math.abs(dy) > touchSlop &&
+                    state != BottomSheetBehavior.STATE_DRAGGING &&
+                    state != BottomSheetBehavior.STATE_SETTLING &&
+                    parent.isPointInChildBounds(scroll, event.x.toInt(), event.y.toInt())
+                ) {
+                    val contentCanContinue =
+                        if (dy < 0) {
+                            scroll.canScrollVertically(1)
+                        } else {
+                            scroll.canScrollVertically(-1)
+                        }
+                    if (!contentCanContinue) {
+                        return true
+                    }
+                }
+            }
+        }
+        return superResult
+    }
+
+    override fun onStopNestedScroll(
+        coordinatorLayout: CoordinatorLayout,
+        child: Screen,
+        target: View,
+        type: Int,
+    ) {
+        // RUYI-637: the detent content override pins the collapsed sheet at
+        // peekHeight, which makes its top equal the fit-to-contents expanded
+        // offset; Material's stop shortcut then misreads the settled collapsed
+        // sheet as expanded, and the settle logic can also target EXPANDED from
+        // the merged position. End the nested scroll without the state flip
+        // while the sheet rests at its collapsed position — onStartNestedScroll
+        // re-initializes the nested-scroll flags on the next gesture, and a
+        // genuine drag or settle passes through untouched.
+        if (state == BottomSheetBehavior.STATE_COLLAPSED &&
+            child.top == super.getExpandedOffset()
+        ) {
+            return
+        }
+        super.onStopNestedScroll(coordinatorLayout, child, target, type)
+    }
+}
