[Unit]
Description=Multica host metrics exporter (node-exporter, RUYI-618)
Wants=network-online.target
After=network-online.target

[Service]
User=@USER@
Group=@GROUP@
ExecStart=@BIN@ --web.listen-address=@LISTEN@
# Host-wide metrics (node-exporter native series): Prometheus scrapes this
# endpoint directly via static targets (deploy/prometheus/prometheus.yml) and
# the Usage panels read the series through the server proxy. Reachability:
# default listen is :9100 on all interfaces so the Prometheus host can reach
# it — firewall the port accordingly (loopback-only installs that only serve
# the local compose stack may pin 127.0.0.1).
ExecStartPost=/bin/sh -c 'sleep 1; curl -fsS http://@LISTEN@/metrics >/dev/null || echo "WARN: node-exporter not answering on @LISTEN@ yet"'
Restart=on-failure
RestartSec=10
# The exporter only reads /proc and /sys: a small fixed budget, far below the
# daemon's, and no OOM special-casing — it is disposable by design.
CPUQuota=@CPU_QUOTA@
MemoryHigh=@MEMORY_HIGH@
MemoryMax=@MEMORY_MAX@
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
