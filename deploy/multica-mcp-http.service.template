[Unit]
Description=Multica MCP server (streamable HTTP transport)
Wants=network-online.target
After=network-online.target

[Service]
# systemd --user 单元：进程天然以当前登录用户运行，无需（也不允许）设置 User=/Group=。
WorkingDirectory=@MCP_DIR@
# bash -lc 包装：以登录 shell 加载用户 bashrc/profile，解析 node（nvm 等）——
# 与 deploy/multica-daemon@.service.template 同一手法，换机器/换 Node 管理器零修改。
#
# 无状态设计：每个 POST /mcp 请求自带 Authorization: Bearer <PAT>。统一 MCP
# 审计凭据通过 systemd LoadCredential 投递到运行时目录；单元仅记录源文件路径，
# 不包含凭据内容。
LoadCredential=multica-mcp-audit:@AUDIT_CREDENTIAL_FILE@
ExecStart=/bin/bash -lc 'exec node "@MCP_DIR@/dist/index.js" --transport http --port @PORT@ --host @HOST@ --audit-credential-file "$CREDENTIALS_DIRECTORY/multica-mcp-audit"'
# 资源护栏：MCP 只是把请求转发到后端 REST API 的无状态代理，没有 daemon 那种
# 长驻 Agent 会话/子进程，画像远小于 daemon；按部署机规格可通过 make 变量覆盖
# （MCP_CPU_QUOTA / MCP_MEMORY_HIGH / MCP_MEMORY_MAX）。
CPUQuota=@CPU_QUOTA@
MemoryHigh=@MEMORY_HIGH@
MemoryMax=@MEMORY_MAX@
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
