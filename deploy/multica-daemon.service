[Unit]
Description=Multica local agent runtime daemon
Wants=network-online.target
After=network-online.target docker.service

[Service]
User=guxy
Group=guxy
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:/home/guxy/bin:/home/guxy/go/bin:/home/guxy/.local/bin:/home/guxy/.bun/bin:/home/guxy/.cargo/bin:/home/guxy/micromamba/condabin:/home/guxy/.nvm/versions/node/v22.22.3/bin:/usr/local/bin:/usr/bin:/usr/local/sbin:/usr/sbin
WorkingDirectory=/home/guxy
# bash -lc 包装：加载 ~/.bashrc/~/.profile 的全部环境变量（含以后新增的
# JAVA_HOME 等）再 exec 交给 daemon；bashrc 即环境变量的单一来源
ExecStart=/bin/bash -lc 'exec /home/linuxbrew/.linuxbrew/bin/multica daemon start --foreground'
ExecStop=/home/linuxbrew/.linuxbrew/bin/multica daemon stop
# 资源护栏（Owner 2026-09-09 定稿）：CPU 最多 6/8 vCPU；内存软顶 16G 限流、
# 硬顶 20G（触发 cgroup 内 OOM 时由 oom-guard 的诱饵机制保证只杀子进程）
CPUQuota=600%
MemoryHigh=24G
MemoryMax=28G
# 杀子保主（Owner 2026-09-10 定稿，取代 ManagedOOMMemoryPressure=kill）：
# 主进程 oom_score_adj=-1000，内核 OOM（cgroup 内或整机）永不选中它；
# 子进程由 multica-oom-guard（user 级 systemd 服务）持续抬到 +500，
# 内存告急时被杀的永远是最肥的 claude/node 子进程，daemon 与其余任务存活。
# 严禁恢复 ManagedOOM*：systemd-oomd 的 kill 是 StopUnit 整棵树连主进程一起杀。
OOMScoreAdjust=-1000
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
