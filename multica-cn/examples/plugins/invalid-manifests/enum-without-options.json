{
  "manifest_version": 1,
  "key": "com.example.enum-without-options",
  "name": "Enum without options",
  "version": "1.0.0",
  "author": { "name": "Example" },
  "scopes": ["issues:read"],
  "config": {
    "environment": { "type": "enum", "label": "Environment" }
  },
  "contributes": {
    "surfaces": [
      { "key": "panel", "type": "issue_panel", "name": "Panel", "entry": "ui/main.js" }
    ]
  }
}
