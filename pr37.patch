 	return adapter.RevokeExecutionScope(ctx, ref, oldScope, nextScope, true)
 }
 
+// revokeLeaseScopesLocked removes every scope that can exist for a terminating lease.
+// A failed Docker phase handoff can create its target scope before the final state
+// write succeeds, so expiry and administrative terminal paths must revoke both
+// generations before releasing the lease.
+func (p *Pool) revokeLeaseScopesLocked(ctx context.Context, snap *store.State, lease *store.Lease, oldPhase string, oldGeneration uint64, oldUID uint32, nextGeneration uint64) error {
+	cleanupErr := p.revokeLeaseScopeLocked(ctx, snap, lease, oldPhase, oldGeneration, oldUID, nextGeneration)
+	if lease.ProviderKind != "docker" || lease.State != store.LeaseExpired || lease.Phase != store.LeasePhaseExpired || (lease.PhaseTarget != store.LeasePhaseDEV && lease.PhaseTarget != store.LeasePhaseQA) || lease.Generation == 0 {
+		return cleanupErr
+	}
+	return errors.Join(cleanupErr, p.revokeLeaseScopeLocked(ctx, snap, lease, lease.PhaseTarget, lease.Generation-1, lease.ExecutionUID, nextGeneration))
+}
