+		}
+	})
+
+	t.Run("reaper", func(t *testing.T) {
+		e := newEnv(t)
+		acquired := e.acquire(t, "tpl-small")
+		e.awaitLease(t, acquired.LeaseID, store.LeaseActive)
+		if err := e.pool.MutateState(func(st *store.State) {
+			for i := range st.Templates {
