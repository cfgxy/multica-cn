+			leaseByID(st, acquired.LeaseID).ScopeProfileKnown = false
+		}); err != nil {
+			t.Fatal(err)
+		}
+
+		e.clock.Advance(61 * time.Minute)
+		e.pool.ReaperRound(context.Background())
+		lease, err := e.pool.GetLease(acquired.LeaseID)
+		if err != nil || lease.State != store.LeaseReclaimed {
+			t.Fatalf("legacy non-Docker lease reaper 不得要求 scope capability: lease=%+v err=%v", lease, err)
+		}
+	})
