+			want: capabilityMatrix{workspacePusher: true, scopedExecution: true, scopedWorkspacePusher: true, scopedWorkspacePath: true, scopedArtifactCollector: true, capabilityExec: true, scopeProfile: true, managedWebBridge: true},
+		},
+		{
+			name: "no-optional-capability", base: providerOnly{Provider: stb},
+			want: capabilityMatrix{},
+		},
+	}
+
+	for _, tc := range cases {
