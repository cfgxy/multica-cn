+func instanceHasTerminalLeaseOwnership(snap *store.State, inst *store.ResourceInstance) bool {
+	for i := range snap.Leases {
+		lease := &snap.Leases[i]
+		if lease.InstanceID == inst.ID && len(lease.PublishedPorts) > 0 &&
+			(lease.State == store.LeaseFailed || lease.State == store.LeaseReleased || lease.State == store.LeaseReclaimed) {
+			return true
+		}
+	}
+	if inst.CurrentLeaseID == "" {
+		return false
+	}
+	lease := leaseByID(snap, inst.CurrentLeaseID)
+	return lease != nil && lease.InstanceID == inst.ID &&
+		(lease.State == store.LeaseFailed || lease.State == store.LeaseReleased || lease.State == store.LeaseReclaimed)
