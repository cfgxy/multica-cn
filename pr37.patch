+// beginAdminReclaimFenceLocked converts a failed phase handoff into the same
+// persisted expiry fence used by the TTL reaper, so both scope generations can
+// be revoked before an administrator terminalizes the lease.
+func (p *Pool) beginAdminReclaimFenceLocked(snap *store.State, lease *store.Lease, now time.Time) (string, uint64, uint32, error) {
+	if !isPhaseHandoff(lease.Phase) {
+		return p.beginReleaseFenceLocked(snap, lease, now)
+	}
+	if lease.PhaseFrom == "" || lease.PhaseFromGeneration == 0 || (lease.PhaseTarget != store.LeasePhaseDEV && lease.PhaseTarget != store.LeasePhaseQA) {
+		return "", 0, 0, fmt.Errorf("阶段交接 scope 身份不完整，拒绝管理回收")
+	}
+	lease.State = store.LeaseExpired
+	lease.Phase = store.LeasePhaseExpired
+	lease.Generation++
+	lease.PhaseUpdatedAt = now
+	lease.PhaseError = ""
+	if err := p.persistLocked(snap); err != nil {
+		return "", 0, 0, fmt.Errorf("管理回收 fencing 持久化失败: %w", err)
+	}
+	return lease.PhaseFrom, lease.PhaseFromGeneration, lease.PhaseFromUID, nil
+}
+
+func isPhaseHandoff(phase string) bool {
+	return phase == store.LeasePhaseHandoffToQA || phase == store.LeasePhaseHandoffToDEV
+}
