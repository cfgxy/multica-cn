+// validateRetainedDockerScopes prevents provider removal from orphaning a scoped
+// Docker data plane that an active or expired lease still requires for cleanup.
+func validateRetainedDockerScopes(state store.State, dockerProvider *docker.Provider) error {
+	if dockerProvider != nil {
+		return dockerProvider.ValidateRetainedScopeProfiles(state)
+	}
+	for _, lease := range state.Leases {
+		if lease.ProviderKind != docker.Kind || (lease.State != store.LeaseActive && lease.State != store.LeaseExpired) {
+			continue
+		}
+		if lease.ScopeProfileID != "" || !lease.ScopeProfileKnown {
+			return fmt.Errorf("存量 Docker 租约 %s（%s）仍需 scope 回收，拒绝移除 Docker provider 后启动", lease.ID, lease.State)
+		}
+	}
+	return nil
+}
