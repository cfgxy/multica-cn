+	object := ScopeObject{
+		Kind: ScopeCompose, Name: names.Project, Labels: labels, ProfileID: profile.ID,
+		ImageDigest: profile.ImageDigest, ServiceImageDigests: profile.ServiceImageDigests,
+		AllowedServices: profile.AllowedServices, RunnerService: profile.RunnerService, ComposeTemplate: profile.ComposeTemplate,
+		DataNamespaces: names.DataNamespaces, NoDockerSocket: true, NoPrivileged: true, NoHostPID: true,
+		NoHostNetwork: true, NoHostMounts: true, NoExternalNetwork: true,
+	}
+	service := func(image string, environment map[string]string) map[string]any {
+		return map[string]any{
+			"profiles": []string{profile.ID}, "image": image, "labels": labelsWithoutKind(object.Labels),
+			"environment": environment, "networks": map[string]any{"scope": nil},
+			"volumes": []map[string]string{{"type": "volume", "source": "data", "target": "/scope"}},
+		}
+	}
+	postgres := service("postgres@"+profile.ServiceImageDigests["postgres"], map[string]string{
+		"POSTGRES_DB": names.DataNamespaces.Database, "POSTGRES_USER": names.DataNamespaces.DBRole, "POSTGRES_PASSWORD": "scope-password",
+	})
+	postgres["healthcheck"] = map[string]any{"test": []string{"CMD-SHELL", "pg_isready"}}
+	runner := service("runner@"+profile.ServiceImageDigests["runner"], map[string]string{
+		"DATABASE_URL": "postgres://" + names.DataNamespaces.DBRole + ":scope-password@postgres:5432/" + names.DataNamespaces.Database + "?sslmode=disable",
+	})
+	runner["depends_on"] = map[string]any{"postgres": map[string]string{"condition": "service_healthy"}}
+	resolved, err := json.Marshal(map[string]any{
+		"services": map[string]any{"postgres": postgres, "runner": runner},
+		"networks": map[string]any{"scope": map[string]any{"name": names.Network, "external": true}},
+		"volumes":  map[string]any{"data": map[string]any{"name": names.Volumes[0], "external": true}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name           string
+		running        string
+		postgres       string
+		wantErr        bool
+		restartService string
+		wantCallCount  int
+	}{
+		{name: "healthy array", running: "postgres\nrunner\n", postgres: `[{"State":"running","Health":"healthy"}]`, wantCallCount: 3},
+		{name: "unhealthy array", running: "postgres\nrunner\n", postgres: `[{"State":"running","Health":"unhealthy"}]`, wantErr: true, wantCallCount: 3},
+		{name: "missing postgres", running: "runner\n", wantErr: true, restartService: "postgres", wantCallCount: 3},
+		{name: "missing runner", running: "postgres\n", postgres: `[{"State":"running","Health":"healthy"}]`, wantErr: true, restartService: "runner", wantCallCount: 4},
+		{name: "missing runner with unhealthy postgres", running: "postgres\n", postgres: `[{"State":"running","Health":"unhealthy"}]`, wantErr: true, wantCallCount: 3},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			runner := (&fakeRunner{}).add(string(resolved)).add(tc.running).add(tc.postgres)
+			runtime, err := NewComposeRuntime(runner, privateScopeRoot(t))
+			if err != nil {
+				t.Fatal(err)
+			}
+			dir := filepath.Join(runtime.root, names.ID)
+			if err := os.MkdirAll(dir, 0o700); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(dir, "compose.yaml"), profile.ComposeTemplate, 0o600); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(dir, "scope.env"), nil, 0o600); err != nil {
+				t.Fatal(err)
+			}
+			err = runtime.ValidateScope(context.Background(), object)
+			if tc.wantErr {
+				if !errors.Is(err, errScopeValidationTransient) {
+					t.Fatalf("暂态健康失败必须保留 transient 分类，得 %v", err)
+				}
+				if tc.restartService != "" {
+					got := strings.Join(runner.argAt(t, tc.wantCallCount-1), " ")
+					if !strings.Contains(got, " up --detach") || !strings.HasSuffix(got, " "+tc.restartService) {
+						t.Fatalf("服务缺席时必须只重启对应 service，得 %s", got)
+					}
+					if tc.restartService == "runner" && !strings.Contains(got, "--no-deps") {
+						t.Fatalf("runner 重启不得同时拉起依赖服务，得 %s", got)
+					}
+				}
+				if runner.callCount() != tc.wantCallCount {
+					t.Fatalf("暂态路径调用数不符：得到 %d，期望 %d", runner.callCount(), tc.wantCallCount)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("标准 JSON array 的 healthy 状态必须允许恢复: %v", err)
+			}
+			if runner.callCount() != tc.wantCallCount {
+				t.Fatalf("健康路径调用数不符：得到 %d，期望 %d", runner.callCount(), tc.wantCallCount)
+			}
+		})
+	}
