+func TestScopeManagerRecoveryPreservesMulticaQAScopeDuringTransientHealthFailures(t *testing.T) {
+	cases := []struct {
+		name     string
+		running  string
+		postgres []byte
+	}{
+		{name: "unhealthy postgres", running: "postgres\nrunner\n", postgres: []byte("{\"State\":\"running\",\"Health\":\"unhealthy\"}\n")},
+		{name: "missing postgres service", running: "runner\n", postgres: []byte("{\"State\":\"running\",\"Health\":\"healthy\"}\n")},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			base := &fakeScopeRuntime{}
+			healthErr := validateMulticaQARuntimeHealth(tc.running, tc.postgres)
+			if healthErr == nil {
+				t.Fatal("测试前提无效：暂态 health 状态必须被拒绝")
+			}
+			runtime := &validatingScopeRuntime{fakeScopeRuntime: base, validationErr: fmt.Errorf("%w: %v", errScopeValidationTransient, healthErr)}
+			issuer := &fakeScopeIssuer{}
+			profile := fixtureProfile(DataPlaneMulticaQA)
+			profile.CredentialIssuerID = "fake-issuer"
+			manager, err := NewScopeManager(profile, issuer, runtime, func(context.Context, ScopeIdentity) error { return nil })
+			if err != nil {
+				t.Fatal(err)
+			}
+			scope := ScopeIdentity{LeaseID: "lease-transient-health", ResourceID: "resource-transient-health", ProfileID: profile.ID, Phase: "QA", Generation: 2}
+			names, err := profile.Namespaces(scope)
+			if err != nil {
+				t.Fatal(err)
+			}
+			base.objects = manager.objects(names)
+
+			if err := manager.Ensure(context.Background(), scope); err == nil {
+				t.Fatal("暂态 health 失败必须向调用方返回可重试错误")
+			}
+			if runtime.validationCalls != 1 || base.cancelled != 0 || issuer.revoked != 0 || issuer.issued != 0 || len(base.removed) != 0 || len(base.created) != 0 {
+				t.Fatalf("暂态 health 失败不得取消、撤销或重建 scope: validation=%d cancelled=%d revoked=%d issued=%d removed=%v created=%v", runtime.validationCalls, base.cancelled, issuer.revoked, issuer.issued, base.removed, base.created)
+			}
+		})
+	}
