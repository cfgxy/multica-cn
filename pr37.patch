+// validateV5Migration 不允许当前二进制接管仍需 Docker runtime 清理的旧 lease。
+// v5 未冻结 profile 身份，直接升 v6 后 release/reaper 可能对错误 scope 操作；必须先
+// 用 v5 服务执行 release_lease 或 reaper，直到这些 lease 进入终态。
+func validateV5Migration(st *State) error {
+	for _, lease := range st.Leases {
+		if lease.ProviderKind != "docker" {
+			continue
+		}
+		switch lease.State {
+		case LeasePending, LeaseActive, LeaseExpired:
+			return fmt.Errorf("状态 v5 存在 Docker 租约 %s（state=%s）；请使用 v5 版本执行 release_lease 或运行 reaper 将其收敛为 failed、released 或 reclaimed 后，再启动当前版本", lease.ID, lease.State)
+		}
+	}
+	return nil
+}
+
+// migrateV5 v5 → v6 将当前模板的 scope profile 冻结到 lease。已通过
+// validateV5Migration 的 Docker lease 均为终态；非 Docker lease 可安全保留其当前
+// profile 语义。模板缺失时保持 unknown，后续 Docker scope 操作继续 fail-closed。
+func migrateV5(st *State) {
+	profilesByTemplate := make(map[string]string, len(st.Templates))
+	for _, template := range st.Templates {
+		profilesByTemplate[template.ID] = template.ScopeProfileID
+	}
+	for i := range st.Leases {
+		profileID, known := profilesByTemplate[st.Leases[i].TemplateID]
+		if known {
+			st.Leases[i].ScopeProfileID = profileID
+			st.Leases[i].ScopeProfileKnown = true
+		}
+	}
 	st.Version = StateVersion
 }
 
