+// ValidateScope re-resolves the persisted Compose project against the currently
+// loaded profile before a recovered scope is accepted as ready.
+func (r *ComposeRuntime) ValidateScope(ctx context.Context, object ScopeObject) error {
+	if object.Kind != ScopeCompose {
+		return errors.New("仅能校验 Compose scope 对象")
+	}
+	if err := validateRuntimeObject(object); err != nil {
+		return err
+	}
+	dir, err := r.scopeDir(object.Labels)
+	if err != nil {
+		return err
+	}
+	composePath := filepath.Join(dir, "compose.yaml")
+	persistedTemplate, err := os.ReadFile(composePath)
+	if err != nil {
+		return fmt.Errorf("读取已恢复 scope Compose 模板: %w", err)
+	}
+	if !bytes.Equal(persistedTemplate, object.ComposeTemplate) {
+		return fmt.Errorf("%w: 已恢复 Compose 模板与当前 profile 不一致", errScopeValidationIncompatible)
+	}
+	resolved, err := r.run(ctx, []string{"compose", "--project-name", object.Name, "--profile", object.ProfileID, "--file", composePath, "--env-file", filepath.Join(dir, "scope.env"), "config", "--format", "json"})
+	if err != nil {
+		return err
+	}
+	if err := validateResolvedCompose([]byte(resolved), object); err != nil {
+		return fmt.Errorf("%w: %v", errScopeValidationIncompatible, err)
+	}
+	if object.ProfileID == "multica-qa" {
+		running, err := r.run(ctx, []string{"compose", "--project-name", object.Name, "--profile", object.ProfileID, "--file", composePath, "--env-file", filepath.Join(dir, "scope.env"), "ps", "--status", "running", "--services"})
+		if err != nil {
+			return err
+		}
+		postgres, err := r.run(ctx, []string{"compose", "--project-name", object.Name, "--profile", object.ProfileID, "--file", composePath, "--env-file", filepath.Join(dir, "scope.env"), "ps", "--format", "json", "postgres"})
+		if err != nil {
+			return err
+		}
+		if err := validateMulticaQARuntimeHealth(running, []byte(postgres)); err != nil {
+			return fmt.Errorf("%w: %v", errScopeValidationIncompatible, err)
+		}
+	}
+	return nil
+}
+
+func validateMulticaQARuntimeHealth(running string, postgresJSON []byte) error {
+	services := strings.Fields(running)
+	if !containsService(services, "postgres") || !containsService(services, "runner") {
+		return errors.New("Multica QA PostgreSQL 或 runner 未运行")
+	}
+	var status []struct {
+		State  string `json:"State"`
+		Health string `json:"Health"`
+	}
+	if err := json.Unmarshal(postgresJSON, &status); err != nil || len(status) != 1 || !strings.EqualFold(status[0].State, "running") || !strings.EqualFold(status[0].Health, "healthy") {
+		return errors.New("Multica QA PostgreSQL 未处于 healthy 状态")
+	}
+	return nil
+}
