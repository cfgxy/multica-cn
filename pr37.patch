+// 调用，因此被拒绝的旧 Docker 租约不会得到任何 v6 侧写入。
+func backupV5Migration(path string, data []byte) error {
+	backupPath := path + ".v5.bak"
+	tmp, err := os.CreateTemp(filepath.Dir(backupPath), "."+filepath.Base(backupPath)+".tmp-*")
+	if err != nil {
+		return fmt.Errorf("创建 v5 迁移备份临时文件: %w", err)
+	}
+	tmpName := tmp.Name()
+	defer func() { _ = os.Remove(tmpName) }()
+	if err := tmp.Chmod(0o600); err != nil {
+		_ = tmp.Close()
+		return fmt.Errorf("设置 v5 迁移备份权限: %w", err)
+	}
+	if _, err := tmp.Write(data); err != nil {
+		_ = tmp.Close()
+		return fmt.Errorf("写入 v5 迁移备份: %w", err)
+	}
+	if err := tmp.Sync(); err != nil {
+		_ = tmp.Close()
+		return fmt.Errorf("同步 v5 迁移备份: %w", err)
+	}
+	if err := tmp.Close(); err != nil {
+		return fmt.Errorf("关闭 v5 迁移备份: %w", err)
+	}
+	if err := os.Rename(tmpName, backupPath); err != nil {
+		return fmt.Errorf("原子替换 v5 迁移备份: %w", err)
+	}
+	return nil
+}
