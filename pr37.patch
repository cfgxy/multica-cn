+		t.Fatalf("默认参数: %v", err)
+	}
+	stb, err := stub.New(cfg, nil)
+	if err != nil {
+		t.Fatalf("stub 构造: %v", err)
+	}
+	cases := []struct {
+		name string
+		base provider.Provider
+		want capabilityMatrix
+	}{
+		{
+			name: "stub", base: stb,
+			want: capabilityMatrix{portPublisher: true, workspacePusher: true},
+		},
+		{
+			name: "hyperv", base: &hyperv.Provider{},
+			want: capabilityMatrix{portPublisher: true, leaseLifecycle: true, workspacePusher: true, scopedExecution: true, scopedWorkspacePusher: true, scopedWorkspacePath: true, scopedArtifactCollector: true, capabilityExec: true},
+		},
