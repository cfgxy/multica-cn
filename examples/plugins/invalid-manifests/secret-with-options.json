{
  "manifest_version": 1,
  "key": "com.example.secret-with-options",
  "name": "Secret with options",
  "version": "1.0.0",
  "author": { "name": "Example" },
  "scopes": ["issues:read"],
  "config": {
    "api_token": { "type": "secret", "label": "API token", "options": ["a", "b"] }
  },
  "contributes": {
    "surfaces": [
      { "key": "panel", "type": "issue_panel", "name": "Panel", "entry": "ui/main.js" }
    ]
  }
}
